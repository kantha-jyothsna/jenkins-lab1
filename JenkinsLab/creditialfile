pipeline {
    agent any

    stages {
        stage('Credentials Demo') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'demo-creds',
                        usernameVariable: 'USER',
                        passwordVariable: 'PASS'
                    )
                ]) {
                    sh '''
                    echo "Username: $USER"
                    echo "Password: $PASS"
                    '''
                }
            }
        }
    }
}
